{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node examples/hooks/veto-demo.mjs",
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node examples/hooks/veto-demo.mjs",
            "timeoutMs": 15000
          }
        ]
      }
    ]
  }
}
