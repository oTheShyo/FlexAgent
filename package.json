{
  "name": "flex-agent",
  "version": "0.1.0",
  "description": "FlexAgent — a desktop coding agent with multi-agent roles, plugins, MCP, skills, and a sandboxed permission gate",
  "license": "MIT",
  "author": "oTheShyo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oTheShyo/FlexAgent.git"
  },
  "homepage": "https://github.com/oTheShyo/FlexAgent#readme",
  "bugs": {
    "url": "https://github.com/oTheShyo/FlexAgent/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.flexagent.desktop",
    "productName": "FlexAgent",
    "artifactName": "${productName}-${version}-setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlexAgent",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "oxlint": "^1.85.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "^5.0.1"
  }
}
