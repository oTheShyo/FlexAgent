# Local agent workspace memory (project-local data, not source).
.workbuddy/
# Transient tool/electron-vite scratch that `git add -A` would sweep up:
# electron-vite writes a numbered `.mjs` build of `electron.vite.config.ts`
# next to the source, and `.impeccable/` is review-tool output.
electron.vite.config.*.mjs
.impeccable/
# Diagnostic walkthroughs leave probes, state, and generated images next to the
# tracked .scratch/zcode-gap tickets; keep the tree visible but the debris out.
/.scratch/*
!/.scratch/zcode-gap/
